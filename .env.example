# Copy to .env to override the docker compose defaults. Defaults are for local development only.
API_PORT=58280
WEB_PORT=58281
SIMULATOR_PORT=58282
POSTGRES_PORT=58632
REDIS_PORT=58679
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only

# false = deterministic feeds (no random latency, failures or maintenance windows); used by CI and benchmarks.
SIMULATOR_CHAOS=true
# false = every comparison is computed from PostgreSQL (the "cold" baseline in docs/benchmarks.md).
CACHE_ENABLED=true

# Set to export traces/metrics to an OTLP collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
