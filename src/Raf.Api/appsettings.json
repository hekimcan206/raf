{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "Freshness": {
    "FreshFor": "06:00:00",
    "AgingFor": "1.00:00:00",
    "ExpireAfter": "7.00:00:00"
  },
  "Comparison": {
    "MaxOverbuyRatio": 0.5,
    "CacheTtl": "00:10:00",
    "CacheEnabled": true
  },
  "Feeds": {
    "DownAfterFailures": 3,
    "SilentAfter": "00:15:00",
    "AttemptTimeout": "00:00:05",
    "MaxPages": 50,
    "Markets": {
      "bereket": { "Url": "http://127.0.0.1:58282/feeds/bereket/prices.json", "Cron": "* * * * *" },
      "carsi": { "Url": "http://127.0.0.1:58282/feeds/carsi/fiyatlar.csv", "Cron": "*/2 * * * *" },
      "kuzey": { "Url": "http://127.0.0.1:58282/feeds/kuzey/fiyat-listesi.xml", "Cron": "*/5 * * * *" },
      "tazelik": { "Url": "http://127.0.0.1:58282/feeds/tazelik/products", "Cron": "*/3 * * * *" }
    }
  },
  "Jobs": {
    "ServerEnabled": true,
    "RegisterRecurringJobs": true,
    "DashboardEnabled": false,
    "WorkerCount": 4,
    "FeedRunRetention": "14.00:00:00"
  },
  "Cors": {
    "Origins": []
  },
  "OpenApi": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
